# .env.example
# Copy this file to ".env" for local development.
# The .env file is listed in .gitignore and will NOT be committed to GitHub.

# Django secret key (keep this secret in production!)
SECRET_KEY=django-insecure-ntc-mahendranagar-travel-management-2024-secret-key

# Set to True for local development, False for production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=127.0.0.1,localhost

# ── DATABASE ─────────────────────────────────────────────
# Leave DATABASE_URL blank to use SQLite locally.
# On Render, this is automatically set to the PostgreSQL connection string.
DATABASE_URL=

# Example PostgreSQL URL format (only needed if using local Postgres):
# DATABASE_URL=postgres://username:password@localhost:5432/ntc_travel
